{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".svelte-kit/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "//#dev:controller": {
      "cache": false,
      "persistent": true
    },
    "//#dev:ansible": {
      "cache": false,
      "persistent": true
    }
  }
}
