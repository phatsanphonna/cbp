{
  "name": "cbp",
  "private": true,
  "packageManager": "bun@1.4.5",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "resolutions": {
    "@esbuild-kit/core-utils/esbuild": "0.25.12"
  },
  "scripts": {
    "dev": "turbo run dev dev:controller --env-mode=loose --continue=dependencies-successful",
    "dev:controller": "bun --env-file=.env.local apps/controller/dev.ts",
    "build": "turbo run build"
  },
  "devDependencies": {
    "turbo": "^2.11.13"
  }
}
